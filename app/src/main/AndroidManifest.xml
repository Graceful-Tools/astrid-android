<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Settings > Contacts: collaborator suggestions, asked for only when the reader taps it (AATD-68). -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <application
        android:name=".AstridApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Astrid">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
            <!-- Share-to-Astrid: iOS's share extension takes one image or file (AATD-60). Text is an
                 Android extra; several files are taken as their first, as iOS's limit of one. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <!-- Web links (iOS DeepLinkManager, AATD-59) on the brand's hosts (AATD-72): astrid.cc and
                 www.astrid.cc for Astrid. Verified only when the brand's server serves assetlinks.json
                 for its release key (astridLinkAutoVerify, AATD-76): not yet for Astrid. -->
            <intent-filter android:autoVerify="${astridLinkAutoVerify}">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="${astridLinkHost}" />
                <data android:host="${astridLinkHostAlt}" />
                <data android:pathPrefix="/t/" />
                <data android:pathPrefix="/tasks/" />
                <data android:pathPrefix="/lists/" />
                <data android:pathPrefix="/settings" />
                <data android:pathPrefix="/s/" />
            </intent-filter>
            <!-- <scheme>://tasks|lists|users|settings|s/…, the older <scheme>://task/…, and <scheme>://new
                 (the launcher shortcut); the brand's scheme, astrid for Astrid (AATD-72). Any other
                 host opens its page on the site. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${astridUrlScheme}" />
                <data android:host="tasks" />
                <data android:host="task" />
                <data android:host="lists" />
                <data android:host="users" />
                <data android:host="settings" />
                <data android:host="s" />
                <data android:host="new" />
            </intent-filter>
            <!-- The browser hand-off's callback (astrid-web lib/auth/desktop-handoff.ts), on the scheme
                 the core is told to accept (CoreSession.start's urlScheme). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${astridUrlScheme}" android:host="auth" android:path="/callback" />
            </intent-filter>
        </activity>
        <!-- Opens a downloaded attachment in another app; only the attachment cache is shared. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
        <receiver android:name=".platform.ReminderActionReceiver" android:exported="false" />
        <receiver android:name=".platform.ReminderAlarmReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
