<resources>
    <!-- The window behind Compose. Compose draws the real theme (ui/theme); this only keeps the
         first frame from flashing a colour the theme is not: `launch_bg`, the brand's default theme's page
         colour, Ocean's cyan for Astrid (app/build.gradle.kts). -->
    <style name="Theme.Astrid" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/launch_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
