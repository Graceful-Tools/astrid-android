<?xml version="1.0" encoding="utf-8"?>
<!-- Android only: iOS has no Home Screen quick action. Opens the share form empty (AATD-60). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="new_task"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_new_task">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="astrid://new"
            android:targetPackage="com.gracefultools.astrid"
            android:targetClass="com.gracefultools.astrid.MainActivity" />
    </shortcut>
</shortcuts>
