<?xml version="1.0" encoding="utf-8"?>
<!-- The template for res/xml/network_security_config.xml, generated by app/build.gradle.kts
     (NetworkSecurityConfig, AATD-100).

     Roots: user-installed ones count as well as the system's. The core's verifier
     (rustls-platform-verifier) already checks against the device's whole store, user roots included,
     so this makes the app's own requests agree with it. An enterprise or partner behind its own CA,
     or an inspecting one, installs its root there, and iOS honours a root the user has trusted in
     Settings.

     The marker becomes the verifier AAR's own list of CA hosts whose CRLs Android's revocation check
     may fetch over plain HTTP. Without it, a certificate with no OCSP URL reads as revoked. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <!-- @VERIFIER_CRL_HOSTS@ -->
</network-security-config>
